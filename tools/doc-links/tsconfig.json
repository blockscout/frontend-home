{
  // The build config: `prepare` and home's own run emit ./dist from it. The root tsconfig.json only
  // type-checks, specs included.
  "compilerOptions": {
    "module": "node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "lib": [ "es2022" ],
    "types": [ "node" ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "./index.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
