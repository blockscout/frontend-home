{
  // The build config: `prepare` emits ./dist from it. The command imports the shared flag parser from ../cli,
  // so rootDir spans the tools folder and the entry points land one level below outDir.
  "compilerOptions": {
    "module": "node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "lib": [ "es2022" ],
    "types": [ "node" ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "..",
    "outDir": "./dist"
  },
  "include": [
    "./index.ts",
    "./lib.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
