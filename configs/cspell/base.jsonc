{
    "version": "0.2",
    "language": "en,en-GB",
    "useGitignore": true,
    "enableGlobDot": true,
    "ignoreRandomStrings": true,
    "allowCompoundWords": true,
    "ignoreRegExpList": [
        // Filecoin f410f-like native addresses
        "f410f[a-z2-7]{39}",
        // IPFS CIDv1 in base32
        "b[a-z2-7]{58}",
        // Specify publisher key
        "spk_\\w+",
        // PostHog project key
        "phc_\\w+",
        // GitHub account names
        "@(\\w|-)+",
        // Russian copy in agent skills (DevOps / Slack templates)
        "[А-Яа-яЁё]+"
    ],
    // What belongs here and what stays in a repository's own list: CONTEXT.md, beside this file.
    "words": [
        "abitype",
        "alfajores",
        "anyblock",
        "anytrust",
